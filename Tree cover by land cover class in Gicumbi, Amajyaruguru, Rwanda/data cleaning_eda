# Step 1: Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Step 2: Load Dataset
file_path = "gicumbi_filtered_data.csv"  # Change to your actual file name
df = pd.read_csv(file_path)

# Step 3: Initial Inspection
print("First 5 rows:")
print(df.head())
print("\nData Types:")
print(df.dtypes)
print("\nMissing Values:")
print(df.isnull().sum())

# Step 4: Handle Missing Values
# Drop rows with all NaN or fill based on context
df = df.dropna(how='all')
df.fillna(method='ffill', inplace=True)

# Step 5: Rename Columns (if necessary)
df.columns = df.columns.str.strip().str.lower().str.replace(" ", "_")

# Step 6: Remove Outliers (optional - example on forest cover)
q1 = df['wri_tropical_tree_cover_extent__ha'].quantile(0.25)
q3 = df['wri_tropical_tree_cover_extent__ha'].quantile(0.75)
iqr = q3 - q1
lower = q1 - 1.5 * iqr
upper = q3 + 1.5 * iqr
df = df[(df['wri_tropical_tree_cover_extent__ha'] >= lower) & (df['wri_tropical_tree_cover_extent__ha'] <= upper)]

# Step 7: Descriptive Statistics
print("\nDescriptive Stats:")
print(df.describe())

# Step 8: Correlation Matrix (if numerical)
plt.figure(figsize=(8, 5))
sns.heatmap(df.corr(numeric_only=True), annot=True, cmap="Greens")
plt.title("Correlation Matrix")
plt.show()

# Step 9: Distribution Plots
plt.figure(figsize=(10, 6))
sns.histplot(df['wri_tropical_tree_cover_extent__ha'], bins=15, kde=True)
plt.title("Distribution of Forest Cover (ha)")
plt.xlabel("Hectares")
plt.ylabel("Frequency")
plt.show()

# Step 10: Sector-wise Forest Cover (Bar Plot)
if 'umd_global_land_cover__ipcc_class' in df.columns:
    sector_forest = df[df['umd_global_land_cover__ipcc_class'] == 'Forest']
    plt.figure(figsize=(10, 6))
    sns.barplot(data=sector_forest, x='adm2', y='wri_tropical_tree_cover_extent__ha')
    plt.title("Forest Cover by Sector in Gicumbi")
    plt.xlabel("Sector Code")
    plt.ylabel("Forest Area (ha)")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()
